---
import Base from '~/layouts/Base.astro';
import ZoneExplorer from '~/components/analyzer/ZoneExplorer';
import { ZONES } from '~/data/zones';
import { INDICATORS } from '~/data/indicators';
---

<Base
  title="Analizar y comparar"
  description="Consulta todos los indicadores de una zona y compárala con otra o con la media nacional."
>
  <section class="shell py-10 md:py-14">
    <h1 class="text-3xl font-black tracking-tight md:text-4xl">Analizar y comparar zonas</h1>
    <p class="mt-3 max-w-prose text-ink-soft">
      Escribe una dirección para ver sus {INDICATORS.length} indicadores. Añade una segunda zona para
      compararlas entre sí o cada una contra la media nacional.
    </p>

    <div class="mt-8">
      <ZoneExplorer zones={ZONES} client:load />
    </div>
  </section>
</Base>

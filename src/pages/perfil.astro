---
import Base from '~/layouts/Base.astro';
import ProfileWizard from '~/components/profile/ProfileWizard';
import { ZONES } from '~/data/zones';
---

<Base
  title="Encuentra tu zona"
  description="Responde cuatro preguntas y ordenamos las zonas por afinidad con tu perfil, explicando el porqué de cada resultado."
>
  <section class="shell py-10 md:py-14">
    <h1 class="text-3xl font-black tracking-tight md:text-4xl">Encuentra tu zona</h1>
    <p class="mt-3 max-w-prose text-ink-soft">
      Cuatro preguntas rápidas. Con tus respuestas ordenamos las {ZONES.length} zonas disponibles por
      afinidad y te enseñamos qué factor suma y cuál resta en cada una.
    </p>

    <div class="mt-8">
      <ProfileWizard zones={ZONES} client:load />
    </div>
  </section>
</Base>

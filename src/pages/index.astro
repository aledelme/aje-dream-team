---
import Base from '~/layouts/Base.astro';
import BrandMotif from '~/components/ui/BrandMotif.astro';
import { site } from '~/config/site';
import { INDICATORS, indicatorsByGroup } from '~/data/indicators';
import { GROUPS, type GroupId } from '~/lib/indicators/types';
import { ZONES } from '~/data/zones';

const groupIds = Object.keys(GROUPS) as GroupId[];
const municipalities = [...new Set(ZONES.map((z) => z.municipality))];

const reglas = [
  {
    titulo: '100 = media de España',
    texto:
      'Cada indicador comparable se expresa como porcentaje respecto a la media nacional ponderada por población.',
  },
  {
    titulo: 'Más alto siempre es mejor',
    texto:
      'Los datos negativos se invierten y se renombran en positivo: la criminalidad se muestra como seguridad.',
  },
  {
    titulo: 'Sin porcentajes forzados',
    texto:
      'Lo que es categórico —inundación, sismo, incendios— se muestra como nivel de riesgo, no como cifra.',
  },
  {
    titulo: 'Se dice de dónde viene cada dato',
    texto: 'Valor absoluto, fuente, nivel de agregación y fórmula, en cada tarjeta.',
  },
];
---

<Base>
  <section class="band-sand border-b border-line">
    <div class="shell grid gap-12 py-16 md:grid-cols-2 md:items-center md:py-24">
      <div>
        <p
          class="inline-flex rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-brand-ink ring-1 ring-brand-line"
        >
          {INDICATORS.length} indicadores de fuentes públicas
        </p>
        <h1 class="mt-5 text-4xl font-extrabold leading-[1.08] text-balance md:text-5xl xl:text-6xl">
          Antes de comprar casa, conoce la zona de verdad.
        </h1>
        <p class="mt-5 max-w-prose text-lg text-ink-soft">
          Seguridad, renta, hospitales, colegios, zonas verdes y riesgos naturales de cada zona. Los
          datos que no aparecen en los portales inmobiliarios, con su fuente y su forma de cálculo
          siempre a la vista.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/perfil" class="btn btn-primary">Encuentra tu zona ideal</a>
          <a href="/analizar" class="btn btn-secondary">Analizar una dirección</a>
        </div>
        <p class="mt-5 text-sm text-ink-soft">
          Cobertura de la demo: {ZONES.length} zonas de {municipalities.length} municipios de Aragón.
        </p>
      </div>

      <BrandMotif class="w-full max-w-lg justify-self-center drop-shadow-sm" />
    </div>
  </section>

  <section class="band-white border-b border-line">
    <div class="shell py-16">
      <h2 class="text-3xl font-extrabold">Cómo leemos los datos</h2>
      <p class="mt-2 max-w-prose text-ink-soft">
        Cuatro reglas fijas para que puedas fiarte de lo que ves, y comprobarlo.
      </p>

      <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          reglas.map((regla, i) => (
            <li>
              <p class="grid h-11 w-11 place-items-center rounded-full bg-brand-soft text-lg font-extrabold text-brand-ink">
                {i + 1}
              </p>
              <h3 class="mt-4 text-lg font-bold">{regla.titulo}</h3>
              <p class="mt-1.5 text-ink-soft">{regla.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="shell py-16">
    <h2 class="text-3xl font-extrabold">Qué puedes consultar de cada zona</h2>
    <p class="mt-2 max-w-prose text-ink-soft">
      Los {INDICATORS.length} indicadores se agrupan en cuatro bloques. Los del bloque de contexto son
      descriptivos: no son buenos ni malos, dependen de lo que busques.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        groupIds.map((groupId) => (
          <div class="card p-6">
            <h3 class="text-lg font-bold">{GROUPS[groupId].label}</h3>
            <p class="mt-1.5 text-sm text-ink-soft">{GROUPS[groupId].description}</p>
            <ul class="mt-4 space-y-1.5 text-sm">
              {indicatorsByGroup(groupId).map((indicator) => (
                <li class="flex items-start gap-2.5">
                  <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
                    aria-hidden="true"
                  />
                  {indicator.label}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell pb-20">
    <div class="grid gap-5 md:grid-cols-2">
      <a href="/perfil" class="card card-hover block p-8">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-ink">Paso 1</p>
        <h3 class="mt-1 text-2xl font-extrabold">Encuentra tu zona</h3>
        <p class="mt-3 text-ink-soft">
          Cuéntanos tu renta, con quién vives, si prefieres ciudad o campo y qué te importa más.
          Ordenamos las {ZONES.length} zonas por afinidad con tu perfil y te explicamos por qué.
        </p>
        <p class="mt-5 font-semibold text-brand-ink">Rellenar el formulario →</p>
      </a>
      <a href="/analizar" class="card card-hover block p-8">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-ink">Paso 2</p>
        <h3 class="mt-1 text-2xl font-extrabold">Analiza y compara</h3>
        <p class="mt-3 text-ink-soft">
          Escribe una dirección, mira todos sus indicadores y ponla frente a otra zona. Puedes
          comparar las dos entre sí o cada una contra la media nacional.
        </p>
        <p class="mt-5 font-semibold text-brand-ink">Abrir el analizador →</p>
      </a>
    </div>

    <p class="mt-8 rounded-xl border border-accent/25 bg-accent-soft p-4 text-sm text-accent-dark">
      {site.demoNotice}
    </p>
  </section>
</Base>

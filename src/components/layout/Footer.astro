---
import { site } from '~/config/site';
import { INDICATORS } from '~/data/indicators';
import { ZONES } from '~/data/zones';

const organisms = [...new Set(INDICATORS.map((i) => i.source.organism))];
---

<footer class="mt-16 border-t border-line bg-white">
  <div class="shell grid gap-8 py-10 md:grid-cols-3">
    <div>
      <p class="text-lg font-bold">{site.name}</p>
      <p class="text-sm text-ink-soft">{site.poweredBy}</p>
      <p class="mt-3 text-sm text-ink-soft">{site.claim}.</p>
    </div>

    <div>
      <p class="font-semibold">Fuentes de los {INDICATORS.length} indicadores</p>
      <ul class="mt-2 space-y-1 text-sm text-ink-soft">
        {organisms.map((organism) => <li>{organism}</li>)}
      </ul>
    </div>

    <div>
      <p class="font-semibold">Cobertura actual</p>
      <p class="mt-2 text-sm text-ink-soft">
        {ZONES.length} zonas de Zaragoza y Aragón. <a href="/metodologia" class="text-brand underline"
          >Ver metodología completa</a
        >.
      </p>
      <p class="mt-3 rounded-md bg-accent-soft p-2 text-xs text-accent-dark">
        {site.demoNotice}
      </p>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="shell flex flex-wrap items-center justify-between gap-3 py-4 text-sm">
      <p class="text-ink-soft">© {new Date().getFullYear()} {site.name}. {site.poweredBy}.</p>
      <nav aria-label="Enlaces legales" class="flex flex-wrap gap-4">
        {
          site.legalNav.map((item) => (
            <a href={item.href} class="text-brand underline">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

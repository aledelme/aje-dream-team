---
import { site } from '~/config/site';
import { INDICATORS } from '~/data/indicators';
import { ZONES } from '~/data/zones';

const organisms = [...new Set(INDICATORS.map((i) => i.source.organism))];
const wordmark = site.name.toLowerCase();
---

<footer class="mt-20 bg-brand-deep text-white">
  <div class="shell grid gap-8 py-12 md:grid-cols-3">
    <div>
      <p class="text-2xl font-extrabold tracking-tight">
        {wordmark}<span class="text-accent">.</span>
      </p>
      <p class="text-sm lowercase tracking-wide text-white/70">{site.poweredBy.toLowerCase()}</p>
      <p class="mt-4 text-sm text-white/80">{site.claim}.</p>
    </div>

    <div>
      <p class="font-semibold">Fuentes de los {INDICATORS.length} indicadores</p>
      <ul class="mt-3 space-y-1 text-sm text-white/70">
        {organisms.map((organism) => <li>{organism}</li>)}
      </ul>
    </div>

    <div>
      <p class="font-semibold">Cobertura actual</p>
      <p class="mt-3 text-sm text-white/80">
        {ZONES.length} zonas de Zaragoza y Aragón. <a
          href="/metodologia"
          class="font-semibold text-white underline decoration-white/40 underline-offset-2 hover:decoration-white"
          >Ver metodología completa</a
        >.
      </p>
      <p class="mt-4 rounded-xl bg-white/10 p-3 text-xs text-white/80">
        {site.demoNotice}
      </p>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="shell flex flex-wrap items-center justify-between gap-3 py-5 text-sm">
      <p class="text-white/70">© {new Date().getFullYear()} {site.name}. {site.poweredBy}.</p>
      <nav aria-label="Enlaces legales" class="flex flex-wrap gap-5">
        {
          site.legalNav.map((item) => (
            <a
              href={item.href}
              class="text-white underline decoration-white/40 underline-offset-2 hover:decoration-white"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
